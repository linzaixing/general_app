HOST=0.0.0.0
PORT=8000

# App 访问网关时使用的 key（对应 App 设置页 API Key）
GATEWAY_API_KEY=replace_with_your_gateway_key

# 可选: dashscope / openai
PROVIDER=dashscope

# 上游模型服务
UPSTREAM_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
UPSTREAM_API_KEY=replace_with_your_upstream_key

# DashScope ASR 兼容参数
DASHSCOPE_ASR_MODEL=qwen3-asr-flash

# 超时（秒）
UPSTREAM_TIMEOUT=120
