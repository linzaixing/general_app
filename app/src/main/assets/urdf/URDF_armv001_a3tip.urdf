    <inertial>
      <origin
        xyz="3.0956E-05 -0.027807 -7.0032E-05"
        rpy="0 0 0" />
      <mass
        value="0.37" />
      <inertia
        ixx="3.2899E-05"
        ixy="2.5288E-06"
        ixz="-2.3777E-08"
        iyy="2.1257E-05"
        iyz="1.4904E-07"
