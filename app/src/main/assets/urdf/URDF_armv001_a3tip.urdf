      </geometry>
    </collision>
  </link>
  <joint
    name="third_joint"
    type="revolute">
    <!-- 2026-10-11：origin 按真实支架 arm_v002b 修正。
         旧值 (0, 0.165989898732231, 0.257913780286487)（D=306.71mm, α=32.76°）
         → 新值 (0, 0.141086, 0.244377)（D=282.179mm CAD 实测，
         α=30.0° 由折叠位 q2=+1.491/q3=−1.084 实测 z≈0.135~0.142 拟合）。
         axis 保持 (−1,0,0)：CAD 两孔轴平行、与 ID2 轴同向，无需改。 -->
    <origin
