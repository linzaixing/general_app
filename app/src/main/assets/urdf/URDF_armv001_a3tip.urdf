    <collision>
      <origin
        xyz="0 0 0"
        rpy="0 0 0" />
      <geometry>
        <mesh
          filename="package://URDF_armv001/meshes/second_Link.STL" />
      </geometry>
    </collision>
  </link>
  <joint
    name="second_joint"
    type="revolute">
    <origin
