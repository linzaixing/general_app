    <origin
      xyz="0 0 0.0785000000000001"
      rpy="0 0 0" />
    <parent
      link="base_link" />
    <child
      link="first_Link" />
    <axis
      xyz="0 0 1" />
    <limit
      lower="-3.14"
      upper="3.14"
      effort="160"
      velocity="20.417" />
  </joint>
  <link
    name="second_Link">
    <inertial>
      <!-- 2026-10-11：惯性保留旧值（0.966 kg，旧支架标称）；真实件为
           arm_v002+v002b 对板（合计 258 cm³），材质未确认——质量/CoM 的修正
           由重力 α 重辨识（StaticGravityIdentifier）吸收，勿在此手工乱改。 -->
      <origin
        xyz="0.000857573444558835 0.0776042459103315 0.130616624503666"
        rpy="0 0 0" />
      <mass
        value="0.966" />
      <inertia
        ixx="0.00246169175712987"
        ixy="7.15160471159471E-06"
        ixz="1.14970999493612E-05"
        iyy="0.00149301141014258"
        iyz="-0.00107551298210178"
        izz="0.0010159642390867" />
    </inertial>
    <!-- 2026-10-11：几何换真实支架四零件整体 second_arm_asm（STEP 实测）。
         来源：f:\Robot\岳强机械臂装配体1.STEP，ID2→ID3 之间的第二关节臂由
         4 个零件组成一个整体（PRODUCT 名自 STEP 解码验证）：
           ① 一轴轴承盖（NAUO26，贴合 v002b 板底面、ID2 轴负向侧）
           ② arm_v002b（NAUO6，基准板：ID3 孔轴过局部 (0,0)、ID2 过 (−280,−35)）
           ③ arm_v002（NAUO5，与 v002b 对扣的上板）
           ④ 二轴螺钉盖2（NAUO28，孔与 ID2 轴同轴 ≤0.0001mm，轴向 +58mm 处）
         四件统一到 v002b 局部系后合成 compound 导出（41047 三角形、米制）；
         装配态复测 ID2/ID3 孔轴垂距 D = 282.1790mm（与单件 v002b 一致，
         偏差 +0.0000mm）。
         visual origin 的作用：把 v002b 局部系的 ID2 孔轴（过局部 (−280,−35)、
         沿局部 Z）对到本 link 的转轴（x 轴），同时把 ID3 孔轴（过局部 (0,0)）
         对到 third_joint 原点——因此 xyz 的 yz 分量恰等于 third_joint origin
         的 (y3,z3)，rpy 为孔轴→x 轴 + 折叠位拟合仰角 30° 的合成旋转。
         换四件整体网格后按同法数值复算：rpy=(1.570796, −0.922858, 1.570796)、
         ID3→(0, 0.141086, 0.244377)，径向标定不变。
         2026-10-12 轴向修正（方案 A，用户确认）：v002b 零件原点的 local z=0
         无物理意义，孔相对 URDF 转轴整体沿轴向偏了约 +20mm，查看器里两头
         电机与夹板之间出现间隙。CAD 实测（四件装配态，v002b 局部系）：
         主电机巢中点 ID2=+19.55（r56.95 壁 z −13.25~+52.36）、ID3=+18.5；
         真实电机本体中点 RS03=+19.7、RS02=+21.3（RS02 顶肩定位、设计上
         本就不在孔跨中点）；原 URDF 的三明治网格（second_Link.STL ±35、
         first_Link/third_Link 电机 ±29~±30）均关于关节原点对称，即原约定
         是「电机三明治中心 = 关节原点」。取 s = −0.020（xyz 的 x 分量）：
         RS03 偏 −0.3mm、RS02 偏 +1.3mm、ID2 主巢偏 −0.45mm，两站全部
         ≤1.3mm 居中，复现原约定。注意两孔全跨度中点不相等（ID2 +20.5 /
         ID3 +17.0，被底部工艺孔与顶部沉孔拉偏），不能按单一孔跨中点取值。 -->
    <visual>
      <origin
        xyz="-0.020 0.141086 0.244377"
        rpy="1.570796 -0.922858 1.570796" />
      <geometry>
        <mesh
          filename="meshes/second_arm_asm.stl" />
      </geometry>
      <material
        name="">
        <color
          rgba="0 0.941176470588235 0.988235294117647 1" />
      </material>
    </visual>
    <collision>
      <origin
        xyz="-0.020 0.141086 0.244377"
        rpy="1.570796 -0.922858 1.570796" />
      <geometry>
        <mesh
          filename="meshes/second_arm_asm.stl" />
      </geometry>
    </collision>
  </link>
