      rpy="0 0 0" />
    <parent
      link="second_Link" />
    <child
      link="third_Link" />
    <axis
      xyz="-1 0 0" />
    <limit
      lower="-0.75"
      upper="2.38"
      effort="17"
      velocity="32.9805" />
  </joint>
  <link
